<Window x:Class="FSM_WPF_MinesweeperFun.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FSM_WPF_MinesweeperFun"
        mc:Ignorable="d"
        Title="3D Minesweeper" Height="450" Width="800">
    <Grid>
        <Grid>
        </Grid>

        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#2b2b2b"
                BorderBrush="#555555"
                BorderThickness="1"
                CornerRadius="5"
                Margin="10">
            <StackPanel Orientation="Vertical" Margin="10">
                <ToggleButton x:Name="TogglePanelButton" Content="Settings" HorizontalAlignment="Left" />

                <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                    <Label Content="Match Name:" Foreground="White" />
                    <TextBox x:Name="MatchNameTextBox" Text="Default" Margin="0,5,0,10" />

                    <Label Content="Player Name:" Foreground="White" />
                    <TextBox x:Name="PlayerNameTextBox" Margin="0,5,0,10" />

                    <Label Content="Player Color:" Foreground="White" />
                    <Rectangle Width="50" Height="20" Fill="Blue" Margin="0,5,0,10" />

                    <CheckBox x:Name="DarkModeCheckBox" Content="Dark Mode" Foreground="White" Margin="0,5,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="ToggleButton.Checked" SourceName="TogglePanelButton">
            <BeginStoryboard>
                <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SettingsPanel" Storyboard.TargetProperty="(UIElement.Visibility)">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                    </ObjectAnimationUsingKeyFrames>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="ToggleButton.Unchecked" SourceName="TogglePanelButton">
            <BeginStoryboard>
                <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SettingsPanel" Storyboard.TargetProperty="(UIElement.Visibility)">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                    </ObjectAnimationUsingKeyFrames>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>